# MCP Research Agent configuration. Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# --- Runtime ---------------------------------------------------------------
# development | test | production. Production refuses to start without APP_API_KEY and MCP_AUTH_TOKEN.
APP_ENV=production
LOG_LEVEL=INFO

# --- LLM (required for chat; tools, uploads and reports work without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional OpenAI-compatible endpoint
OPENAI_BASE_URL=

# --- Embeddings ------------------------------------------------------------
# local  = bundled all-MiniLM-L6-v2 ONNX model (free, offline, baked into the Docker image)
# openai = OpenAI embeddings (requires OPENAI_API_KEY). Changing this uses a separate Chroma collection.
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- GitHub (optional; raises the anonymous 60 req/h limit to 5,000 req/h) --
# A fine-grained token with *no* repository permissions (public read only) is sufficient.
GITHUB_TOKEN=

# --- Authentication (required in production) --------------------------------
# REST API key: send as `X-API-Key: <key>` or `Authorization: Bearer <key>`; enter it in the web UI.
APP_API_KEY=change-me-run-openssl-rand-hex-32
# Bearer token required by the MCP endpoint (/mcp) for every MCP client, including the agent.
MCP_AUTH_TOKEN=change-me-run-openssl-rand-hex-32

# --- URLs ------------------------------------------------------------------
# Public origin users reach (used in report download links and as the MCP OAuth resource id).
PUBLIC_BASE_URL=http://localhost:8000
# MCP endpoint the agent connects to. docker-compose overrides this with http://mcp:8100/mcp.
MCP_BASE_URL=http://localhost:8000/mcp

# --- ChromaDB --------------------------------------------------------------
# http = Chroma server (required in production); ephemeral = in-memory (tests only)
CHROMA_MODE=http
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false

# --- Storage (docker-compose sets container paths on the persistent volume) --
DATA_DIR=./data/runtime
REPORTS_DIR=./data/reports

# --- HTTP hardening ----------------------------------------------------------
# Comma-separated. Browser origins allowed to call the API / MCP endpoint.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Comma-separated Host header values accepted by the API and MCP server (add your domain).
ALLOWED_HOSTS=localhost,127.0.0.1
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=12

# --- RAG ---------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
# Cosine-distance cut-off; passages farther than this are not used as evidence.
RAG_MAX_DISTANCE=0.75

# --- Agent limits ------------------------------------------------------------
AGENT_MAX_TOOL_CALLS=8
AGENT_RECURSION_LIMIT=25
AGENT_REQUEST_TIMEOUT_S=180
AGENT_TOOL_TIMEOUT_S=90
HTTP_TIMEOUT_S=20

# --- docker-compose only -------------------------------------------------------
# Host interface/port the API is published on. Keep 127.0.0.1 behind a reverse proxy.
API_BIND=127.0.0.1
API_PORT=8000
